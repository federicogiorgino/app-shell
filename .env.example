# Base URL of your API (no trailing slash). Leave empty when the app has no backend.
# iOS simulator / web: http://localhost:3000
# Android emulator:    http://10.0.2.2:3000
# Physical device:     http://<your-computer-LAN-IP>:3000, or the deployed https URL
EXPO_PUBLIC_API_URL=

# 1: sign-in is required (Better Auth, served by EXPO_PUBLIC_API_URL). 0 or empty: no accounts,
# the app opens straight into the tabs after onboarding.
EXPO_PUBLIC_AUTH_ENABLED=0
