  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~58.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "~6.0.3",
