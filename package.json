    "expo-web-browser": "~58.0.7",
    "heroui-native": "^1.0.11",
    "i18next": "^26.7.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.11",
    "react-native": "0.88.1",
