    "@hookform/resolvers": "^7.0.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/query-async-storage-persister": "^5.105.2",
    "@tanstack/react-query": "^5.105.2",
    "@tanstack/react-query-persist-client": "^5.105.2",
    "better-auth": "^1.7.14",
    "expo": "~58.0.22",
    "expo-blur": "~58.0.5",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
