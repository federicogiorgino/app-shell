    "expo-linking": "~58.0.13",
    "expo-localization": "~58.0.5",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.10",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "^58.0.4",
